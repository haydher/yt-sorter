{
  "manifest_version": 3,
  "name": "YouTube Queue Sorter",
  "version": "1.0.0",
  "description": "Adds a Sort button to the YouTube queue that sorts it by video length.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
